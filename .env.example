# Copy to .env and fill in. Never commit .env.

# --- Database ---------------------------------------------------------------
# Local docker-compose Postgres + pgvector (Sprint 1 default).
# When moving to Supabase, replace this with the Supabase connection string.
DATABASE_URL=postgresql://research:research@localhost:5433/research_intelligence

# --- Storage ----------------------------------------------------------------
# Which StorageBackend to use: "local" (Sprint 1) or "supabase" (not implemented yet).
STORAGE_BACKEND=local
# Where LocalStorage writes uploaded PDFs. Relative paths resolve from the repo root.
LOCAL_STORAGE_DIR=storage

# --- Upload limits ----------------------------------------------------------
MAX_UPLOAD_BYTES=52428800

# --- API --------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
# Comma-separated origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# --- Frontend ---------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Supabase (NOT used in Sprint 1 — left here so the swap is documented) ---
# Decision (see PROGRESS.md): Sprint 1 runs on local Postgres. These stay empty
# until a Supabase project is provisioned for this platform.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=papers

# --- AI providers (NOT used in Sprint 1) ------------------------------------
# Interfaces exist as stubs only. No provider is wired up until Sprint 3+.
